# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (Supabase / PostgreSQL)
# Pilihan A - Direct Connection (Disarankan untuk migrate & port 5432):
# DATABASE_URL=postgresql://postgres:PASSWORD_ANDA@db.PROJECT_REF.supabase.co:5432/postgres
#
# Pilihan B - Session / Transaction Pooler (Supabase):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD_ANDA@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#
# CATATAN PENTING: Jika password Anda memiliki karakter khusus (@, #, $, %, !),
# pastikan di-encode (misal: @ menjadi %40, # menjadi %23).
DATABASE_URL=postgresql://postgres:yourpassword@db.xxxxxxxx.supabase.co:5432/postgres

# Frontend URL (untuk izin CORS dan WebSocket)
FRONTEND_URL=http://localhost:5173

# Keamanan JWT
JWT_SECRET=ecoplay-rahasia-guru-2026-super-secure
